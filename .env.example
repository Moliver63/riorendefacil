# Copie para .env. Nunca versione o .env.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Banco: em produção, a URL do Postgres do Render. Vazio em dev = PGlite local.
DATABASE_URL=

# Sessão: gere com  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# E-mails que viram admin no primeiro login (separados por vírgula)
ADMIN_EMAILS=
# Quem recebe aviso de lead novo
EMAILS_ASSESSORES=

# Login com Google (opcional). Callback: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_REMETENTE=RioRendeFácil <contato@riorendefacil.com.br>

# Cron: o Render Cron Job manda  Authorization: Bearer {CRON_SECRET}
CRON_SECRET=

# Cofre de documentos (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Analytics (só carregam após consentimento)
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_CLARITY_ID=

# Emissor parceiro. Enquanto EMISSOR_AUTORIZADO=false, nenhuma marca de emissor
# aparece e captação e resgate ficam travados.
EMISSOR_AUTORIZADO=false
EMISSOR_NOME=
EMISSOR_RAZAO_SOCIAL=
EMISSOR_CNPJ=
EMISSOR_REGISTRO_CVM=
EMISSOR_LOGO_URL=
EMISSOR_SITE=
EMISSOR_CUSTODIANTE=
EMISSOR_AUDITOR=
PRAZO_RESGATE_DIAS=7
CARENCIA_PRINCIPAL_DIAS=60
