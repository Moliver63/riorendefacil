{
  "name": "riorendefacil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de tecnologia para captação e portal do investidor em renda fixa estruturada (CCB) operada por emissor licenciado.",
  "scripts": {
    "dev": "tsx watch --ignore ./client server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test shared/*.test.ts server/__tests__/*.test.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/react-query": "^5.59.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.32.0",
    "superjson": "^2.2.6",
    "wouter": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "drizzle-kit": "^0.28.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
